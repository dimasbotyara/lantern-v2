# ==============================================================================
# 🔐 СЕКРЕТЫ И БЕЗОПАСНОСТЬ (Критически важно!)
# ==============================================================================
# Ключи шифрования в корне и любых подпапках (например, в server/)
*encryption.key
*encryption.key.backup

# Локальные файлы окружения с токенами и паролями (если появятся в будущем)
.env
.env.*
*.env

# ==============================================================================
# 🗄️ БАЗЫ ДАННЫХ И ХРАНИЛИЩЕ ПОЛЬЗОВАТЕЛЕЙ
# ==============================================================================
# Локальная база данных SQLite
*.db
*.sqlite3

# Папка со скачанными файлами пользователей, стикерами и миниатюрами
storage/files/
storage/stickers/
storage/thumbnails/
# Если хочешь полностью игнорировать всё внутри storage, но оставить саму структуру:
# storage/**/*

# ==============================================================================
# 🐍 Python (Кэш и виртуальное окружение)
# ==============================================================================
# Виртуальные окружения
.venv/
venv/
ENV/
env/

# Кэш компиляции Python (рекурсивно уберёт все __pycache__)
__pycache__/
*.pyc
*.pyo
*.pyd

# Дистрибутивы, сборки и метаданные (если будешь упаковывать проект)
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# 💻 НАСТРОЙКИ IDE / ОС (Разработка на Arch Linux + VS Code/JetBrains)
# ==============================================================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Системные файлы
.DS_Store
Thumbs.db

# ==============================================================================
# 📊 ЛОГИ И ТЕСТЫ
# ==============================================================================
*.log
logs/
.pytest_cache/
.coverage
htmlcov/

# ==============================================================================
# 🔧 ДОПОЛНЕНИЯ (то, что было в старом .gitignore)
# ==============================================================================
# Конфиги клиента (создаются в ~/.lantern_v2/)
client_config.json
auth_tokens.json

# Temp-файлы
tmp/
temp/
*.bak

# SQLite WAL/SHM (журналы БД)
*.db-shm
*.db-wal
*.sqlite

# IDE
*.code-workspace

# Windows
desktop.ini

# Линтеры (свежие)
.ruff_cache/
.mypy_cache/

# Пример env (не игнорируем!)
!.env.example
